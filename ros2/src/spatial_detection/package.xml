<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spatial_detection</name>
  <version>0.1.0</version>
  <description>ROS2 node for YOLO spatial object detection using Luxonis DepthAI camera.</description>
  <maintainer email="vikram.kommera@gmail.com">vkommera</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>

  <!-- depthai is not a rosdep key; install via: pip install depthai
       or build from source so that its CMake config is on the system path. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
